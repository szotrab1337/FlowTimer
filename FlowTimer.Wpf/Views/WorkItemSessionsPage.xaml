<Page
    x:Class="FlowTimer.Wpf.Views.WorkItemSessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:NKristek.Wpf.Converters;assembly=NKristek.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:FlowTimer.Wpf.ViewModels"
    Title="WorkItemSessionsPage"
    d:DataContext="{d:DesignInstance Type=viewModels:WorkItemSessionsViewModel,
                                     IsDesignTimeCreatable=True}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal">
            <Button
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                Command="{Binding GoBackCommand}"
                ToolTip="Powrót">
                <TextBlock
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Text="&#xE72B;" />
            </Button>
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{DynamicResource TitleTextBlockStyle}"
                Text="Sesje" />
        </StackPanel>

        <Button
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding AddSessionCommand}"
            Style="{DynamicResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,2,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Text="&#xE710;" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Text="Dodaj sesję" />
            </StackPanel>
        </Button>

        <TextBlock
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextOnAccentFillColorDisabledBrush}"
            Text="Dodaj pierwszą sesję!">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding Sessions.Count}"
                            Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ListView
            Grid.Row="1"
            Margin="0,15,0,0"
            ItemsSource="{Binding Sessions}">
            <ListView.ItemContainerStyle>
                <Style
                    BasedOn="{StaticResource {x:Type ListViewItem}}"
                    TargetType="ListViewItem">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsActive}"
                            Value="{StaticResource True}">
                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>

                    <Grid Margin="5,10,5,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding TotalTime}" />

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text=" - "
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding EndTime, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.EditSessionCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                            CommandParameter="{Binding}"
                            ToolTip="Edytuj"
                            Visibility="{Binding IsActive, Converter={c:BoolToInverseVisibilityConverter}}">
                            <TextBlock
                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Text="&#xE70F;" />
                        </Button>

                        <Button
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.ArchiveSessionCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                            CommandParameter="{Binding}"
                            ToolTip="Usuń"
                            Visibility="{Binding IsActive, Converter={c:BoolToInverseVisibilityConverter}}">
                            <TextBlock
                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Text="&#xE74D;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
